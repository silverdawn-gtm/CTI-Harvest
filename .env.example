# Postgres runs in Docker under WSL, published on host port 5433 (5432 is taken by a
# native Windows PostgreSQL 17 service). Reachable from Windows via mirrored networking.
#
# Use 127.0.0.1, not localhost: Windows resolves "localhost" to ::1 first, and the
# container publishes on IPv4 only (0.0.0.0:5433), so every connection stalls for the
# full connect timeout on ::1 before falling back to IPv4.
DATABASE_URL=postgresql+psycopg://crawler:crawler@127.0.0.1:5433/crawler

# Separate database used by the test suite. Create it once with:
#   docker exec crawler-db createdb -U crawler crawler_test
TEST_DATABASE_URL=postgresql+psycopg://crawler:crawler@127.0.0.1:5433/crawler_test

RAW_ARCHIVE_DIR=data/raw

# LLM extraction (`crawler extract`). Fill in the key for the provider you pick.
# Provider: mistral, gemini or grok. All three are sent a strict JSON schema.
LLM_PROVIDER=mistral
# Requests in flight at once, and the per-minute ceiling for the provider's host.
LLM_PARALLEL=4
LLM_REQUESTS_PER_MINUTE=30

MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest
MISTRAL_FALLBACK_MODELS=ministral-8b-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=

GROK_API_KEY=
GROK_MODEL=grok-4-fast-non-reasoning
GROK_FALLBACK_MODELS=
