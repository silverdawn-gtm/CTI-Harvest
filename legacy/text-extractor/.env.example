# Copy this file to .env and fill in at least one API key.
# Which LLM to use: mistral, gemini or grok
LLM_PROVIDER=mistral
# How many sentences to send to the LLM at the same time (1 = one after another)
LLM_PARALLEL=4

# Mistral (https://console.mistral.ai) - free "Experiment" plan works with the ministral models
MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=ministral-14b-latest
MISTRAL_FALLBACK_MODELS=ministral-8b-latest

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash

# xAI Grok (https://console.x.ai) - paid API credits
GROK_API_KEY=your-xai-key
GROK_MODEL=grok-4-fast-non-reasoning
GROK_FALLBACK_MODELS=
